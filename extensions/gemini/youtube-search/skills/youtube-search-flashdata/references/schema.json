{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "Search text to send to this data source."
    },
    "max_results": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 20,
      "description": "Maximum number of YouTube search results requested; the source-specific limit applies."
    },
    "filters": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "360": {
          "type": "boolean",
          "description": "Apply the YouTube 360-degree video filter."
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "enum": [
            "<4",
            "4-20",
            ">20"
          ],
          "description": "Filter by video length in minutes."
        },
        "sort_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "enum": [
            "rating",
            "relevance",
            "view_count",
            "upload_date"
          ],
          "description": "YouTube result ordering."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "enum": [
            "video",
            "channel",
            "playlist",
            "movie"
          ],
          "description": "YouTube content type to include."
        },
        "upload_date": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "enum": [
            "today",
            "last_hour",
            "this_week",
            "this_month",
            "this_year"
          ],
          "description": "Relative upload-time window."
        },
        "3d": {
          "type": "boolean",
          "description": "Apply the YouTube 3D filter."
        },
        "4k": {
          "type": "boolean",
          "description": "Apply the YouTube 4K filter."
        },
        "creative_commons": {
          "type": "boolean",
          "description": "Apply the Creative Commons label filter; this does not grant usage rights."
        },
        "hd": {
          "type": "boolean",
          "description": "Apply the YouTube HD filter."
        },
        "hdr": {
          "type": "boolean",
          "description": "Apply the YouTube HDR filter."
        },
        "live": {
          "type": "boolean",
          "description": "Apply the YouTube live filter."
        },
        "location": {
          "type": "boolean",
          "description": "Apply the YouTube location-tagged content filter."
        },
        "purchased": {
          "type": "boolean",
          "description": "Apply the YouTube purchased-content filter."
        },
        "subtitles": {
          "type": "boolean",
          "description": "Apply the YouTube subtitles filter."
        },
        "vr180": {
          "type": "boolean",
          "description": "Apply the YouTube VR180 filter."
        }
      },
      "description": "YouTube search filters. Omit or use null for no filters."
    },
    "mode": {
      "type": "string",
      "enum": [
        "realtime",
        "async"
      ],
      "default": "realtime",
      "description": "realtime waits for data; async returns a job ID to poll with get_job. Does not change query billing."
    }
  },
  "required": [
    "query"
  ]
}
