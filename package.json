{
  "name": "@flashdata-dev/mcp",
  "version": "0.2.0",
  "description": "FlashData CLI and MCP server for Google Search, YouTube data and media delivery to customer storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashdata-dev/flashdata-mcp.git"
  },
  "homepage": "https://flashdata.dev/mcp?utm_source=npm&utm_medium=integration&utm_campaign=intent_gtm_2026q4&utm_content=combined",
  "bugs": {
    "url": "https://github.com/flashdata-dev/flashdata-mcp/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "flashdata-mcp": "bin/flashdata-mcp.js",
    "flashdata": "bin/flashdata.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./server": "./src/mcp/server.js",
    "./tool-catalog": "./src/mcp/toolCatalog.js",
    "./data-api-client": "./src/mcp/dataApiClient.js",
    "./job-api-client": "./src/mcp/jobApiClient.js",
    "./catalog": "./src/catalog/sourceCatalog.js",
    "./download-options": "./src/download/youtubeDownloadOptions.js",
    "./youtube-options": "./src/youtube/youtubeSearchOptions.js",
    "./result-chunks": "./src/mcp/resultChunks.js"
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node bin/flashdata-mcp.js",
    "test": "node --test test/memory-store.test.js test/stdio.test.js test/http-security.test.js test/cli.test.js test/task-servers.test.js",
    "test:install": "node scripts/test-install.js",
    "check:package": "node scripts/check-package.js",
    "sync:claude-plugin": "node scripts/sync-claude-plugin.js",
    "check:claude-plugin": "node scripts/sync-claude-plugin.js --check",
    "prepack": "npm test && npm run check:package",
    "build:smithery": "node scripts/build-smithery.js",
    "build:npm-tasks": "node scripts/build-npm-tasks.js",
    "test:npm-tasks": "node scripts/test-npm-tasks.js",
    "sync:task-integrations": "node scripts/sync-task-integrations.js",
    "check:task-integrations": "node scripts/sync-task-integrations.js --check",
    "test:task-integrations": "node --test test/task-integrations.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "axios": "1.20.0"
  },
  "keywords": [
    "flashdata",
    "mcp",
    "cli",
    "agent",
    "google-search",
    "youtube",
    "transcript"
  ],
  "devDependencies": {
    "fflate": "0.8.3"
  }
}
