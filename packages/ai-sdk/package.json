{
  "name": "@flashdata-dev/ai-sdk",
  "version": "0.2.1",
  "description": "Google search and YouTube data tools for AI SDK agents, with asynchronous media delivery to customer storage.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashdatadev/flashdata-mcp.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://flashdata.dev/?utm_source=vercel-ai-sdk&utm_medium=integration&utm_campaign=intent_gtm_2026q4&utm_content=combined",
  "bugs": {
    "url": "https://github.com/flashdatadev/flashdata-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai-sdk",
    "agent",
    "google-search",
    "youtube",
    "transcript",
    "flashdata"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "ai": "^7.0.143",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/node": "^24.19.2",
    "ai": "7.0.143",
    "typescript": "6.0.3",
    "zod": "4.1.8"
  }
}
