{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "video_id": {
      "type": "string",
      "minLength": 11,
      "maxLength": 11,
      "pattern": "^[A-Za-z0-9_-]{11}$"
    },
    "include_formats": {
      "type": "boolean",
      "default": true
    },
    "include_chapters": {
      "type": "boolean",
      "default": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "realtime",
        "async"
      ],
      "default": "realtime"
    }
  },
  "required": [
    "video_id"
  ]
}
